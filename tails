def dibujar_barra(x, y, nombre, valor):
    texto = fuente_chica.render(nombre, True, BLANCO)
    pantalla.blit(texto, (x, y))
    pygame.draw.rect(pantalla, BORDO_OSCURO, (x, y + 20, 240, 18), border_radius=4)
    ancho = int(236 * valor / 100)
    color = AMARILLO
    if valor < 25:
        color = (235, 50, 50)
    if ancho > 0:
        pygame.draw.rect(pantalla, color, (x + 2, y + 22, ancho, 14), border_radius=3)
    pygame.draw.rect(pantalla, BLANCO, (x, y + 20, 240, 18), 2, border_radius=4)
    num = fuente_chica.render(str(int(valor)) + "%", True, BLANCO)
    pantalla.blit(num, (x + 205, y))


def dibujar_barras():
