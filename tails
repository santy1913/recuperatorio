def dibujar_escudo_a_mano():
    # Versión para editores online donde no se puede subir la carpeta assets/:
    # dibujo el escudo del IPET 249 con código.
    surf = pygame.Surface((87, 104), pygame.SRCALPHA)
    forma = [(4, 4), (83, 4), (83, 62), (43, 100), (4, 62)]
    pygame.draw.polygon(surf, AMARILLO, forma)
    pygame.draw.polygon(surf, NEGRO, forma, 2)
    # engranajes
    for (gx, gy, r) in ((34, 30, 13), (52, 24, 9)):
        for i in range(8):
            ang = i * math.pi / 4
            px = gx + math.cos(ang) * (r + 2)
            py = gy + math.sin(ang) * (r + 2)
            pygame.draw.circle(surf, (230, 90, 110), (int(px), int(py)), 3)
        pygame.draw.circle(surf, (230, 90, 110), (gx, gy), r)
        pygame.draw.circle(surf, AMARILLO, (gx, gy), r // 3)
    f = pygame.font.SysFont("timesnewroman", 15, bold=True)
    for letra, pos in (("I", (10, 46)), ("P", (26, 40)), ("E", (44, 34)), ("T", (62, 22))):
        surf.blit(f.render(letra, True, NEGRO), pos)
    surf.blit(pygame.font.SysFont("timesnewroman", 20, bold=True).render("249", True, NEGRO), (28, 58))
    surf.blit(pygame.font.SysFont("timesnewroman", 9, bold=True).render("Nicolás Copérnico", True, NEGRO), (10, 82))
    return surf


ruta_escudo = os.path.join(CARPETA, "assets", "escudo.png")
if os.path.exists(ruta_escudo):
    escudo = pygame.image.load(ruta_escudo).convert_alpha()
    escudo = pygame.transform.smoothscale(escudo, (87, 104))
else:
    escudo = dibujar_escudo_a_mano()

# ---------------------------------------------------------------- estado de la mascota
mascota = {
    "energia": 100.0,
    "animo": 100.0,
    "salud": 100.0,
    "programando": 0.0,   # segundos que le quedan programando
    "mensaje": "",
    "t_mensaje": 0.0,
}

# posiciones fijas donde aparecen los bugs cuando baja la salud
POS_BUGS = [(230, 400), (570, 395), (250, 250), (540, 250), (400, 432)]


def limitar(valor):
    # que las barras siempre queden entre 0 y 100
    return max(0, min(100, valor))


def avisar(texto):
    mascota["mensaje"] = texto
    mascota["t_mensaje"] = 2.0


# ---------------------------------------------------------------- acciones del jugador
def tomar_cafe():
    mascota["energia"] = limitar(mascota["energia"] + 25)
    avisar("¡Glup glup! Café cargado")


def programar():
    if mascota["energia"] < 15:
        avisar("¡Sin batería! Dale un café primero")
        return
    mascota["energia"] = limitar(mascota["energia"] - 15)
    mascota["animo"] = limitar(mascota["animo"] + 20)
    mascota["salud"] = limitar(mascota["salud"] - 5)   # programar deja bugs
    mascota["programando"] = 2.5
    avisar("Compilando... (ojo con los bugs)")


def limpiar_bugs():
    mascota["salud"] = limitar(mascota["salud"] + 25)
    avisar("Bugs eliminados")


def reiniciar():
    mascota["energia"] = 100.0
    mascota["animo"] = 100.0
    mascota["salud"] = 100.0
    mascota["programando"] = 0.0
    avisar("Byte reiniciado")


botones = [
    (pygame.Rect(30, 505, 230, 55), "[C] Tomar café", tomar_cafe),
    (pygame.Rect(285, 505, 230, 55), "[J] Programar", programar),
    (pygame.Rect(540, 505, 230, 55), "[L] Limpiar bugs", limpiar_bugs),
]


# ---------------------------------------------------------------- lógica
def obtener_estado():
    if mascota["programando"] > 0:
        return "programando"
    if mascota["energia"] < 25:
        return "cansado"
    if mascota["animo"] < 30 or mascota["salud"] < 30:
        return "triste"
    return "feliz"


def actualizar(dt):
    # dt = segundos que pasaron desde el frame anterior, así el desgaste
    # es igual sin importar los FPS de la compu
    mascota["energia"] = limitar(mascota["energia"] - DESGASTE_ENERGIA * dt)
    mascota["animo"] = limitar(mascota["animo"] - DESGASTE_ANIMO * dt)
    mascota["salud"] = limitar(mascota["salud"] - DESGASTE_SALUD * dt)

    # si está sin energía también se deprime más rápido
    if mascota["energia"] < 25:
        mascota["animo"] = limitar(mascota["animo"] - 1.0 * dt)

    if mascota["programando"] > 0:
        mascota["programando"] -= dt
    if mascota["t_mensaje"] > 0:
        mascota["t_mensaje"] -= dt


