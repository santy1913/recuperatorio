    dibujar_barra(520, 68, "Ánimo (nivel de código)", mascota["animo"])
    dibujar_barra(520, 116, "Salud (limpio de bugs)", mascota["salud"])


def dibujar_botones():
    pos_mouse = pygame.mouse.get_pos()
    for rect, texto, accion in botones:
        color = BORDO
        if rect.collidepoint(pos_mouse):
            color = ROJO
        pygame.draw.rect(pantalla, color, rect, border_radius=10)
        pygame.draw.rect(pantalla, BLANCO, rect, 3, border_radius=10)
        t = fuente.render(texto, True, BLANCO)
        pantalla.blit(t, t.get_rect(center=rect.center))


def dibujar_cola(x, y, angulo):
    # dibujo la cola horizontal en una superficie aparte y después la roto
    surf = pygame.Surface((160, 160), pygame.SRCALPHA)
    pygame.draw.ellipse(surf, NARANJA, (20, 60, 120, 40))
    pygame.draw.ellipse(surf, BLANCO, (20, 64, 40, 32))   # punta blanca
    rotada = pygame.transform.rotate(surf, angulo)
    rad = math.radians(angulo)
    # la base de la cola está a 60px del centro, hay que acomodar el centro
    centro_x = x - 60 * math.cos(rad)
    centro_y = y + 60 * math.sin(rad)
    pantalla.blit(rotada, rotada.get_rect(center=(centro_x, centro_y)))


def dibujar_bug(x, y, t):
    x = x + math.sin(t * 3 + y) * 6   # se mueve un poquito
    for i in (-1, 0, 1):
        pygame.draw.line(pantalla, NEGRO, (x - 10, y + i * 5), (x - 18, y + i * 8), 2)
        pygame.draw.line(pantalla, NEGRO, (x + 10, y + i * 5), (x + 18, y + i * 8), 2)
    pygame.draw.ellipse(pantalla, NEGRO, (x - 11, y - 8, 22, 16))
    pygame.draw.circle(pantalla, ROJO, (int(x - 3), int(y - 2)), 3)
    pygame.draw.circle(pantalla, ROJO, (int(x + 4), int(y + 2)), 3)


