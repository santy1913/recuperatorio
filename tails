def dibujar_mascota(estado, t):
    cx = 400
    cy = 290
    if estado in ("feliz", "programando"):
        cy += math.sin(t * 4) * 4   # saltito
    else:
        cy += math.sin(t * 1.5) * 2

    # colas (se caen cuando está triste o cansado)
    if estado in ("triste", "cansado"):
        angulo1, angulo2 = 35, 15
    else:
        meneo = math.sin(t * 5) * 15
        angulo1, angulo2 = -25 + meneo, -55 - meneo
    dibujar_cola(cx - 30, cy + 85, angulo1)
    dibujar_cola(cx - 30, cy + 85, angulo2)

    # zapatillas rojas
    for dx in (-52, 2):
        pygame.draw.ellipse(pantalla, ROJO, (cx + dx, cy + 132, 50, 26))
        pygame.draw.line(pantalla, BLANCO, (cx + dx + 8, cy + 143), (cx + dx + 40, cy + 143), 4)

    # buzo rojo con detalles amarillos y logo
    pygame.draw.ellipse(pantalla, ROJO, (cx - 60, cy + 10, 120, 135))
    pygame.draw.ellipse(pantalla, AMARILLO, (cx - 60, cy + 10, 120, 135), 4)
    pygame.draw.circle(pantalla, AMARILLO, (cx + 25, cy + 70), 14)
    logo = fuente_chica.render("249", True, BORDO)
    pantalla.blit(logo, logo.get_rect(center=(cx + 25, cy + 70)))

    # brazos
    if estado == "programando":
        # teclado y manos sobre las teclas
        pygame.draw.rect(pantalla, NEGRO, (cx - 75, cy + 112, 150, 18), border_radius=4)
        for i in range(10):
            pygame.draw.rect(pantalla, BLANCO, (cx - 68 + i * 14, cy + 116, 9, 8))
        golpe = math.sin(t * 20) * 4
        manos_izq = (cx - 35, cy + 108 + golpe)
        manos_der = (cx + 35, cy + 108 - golpe)
        pygame.draw.line(pantalla, ROJO, (cx - 50, cy + 50), manos_izq, 20)
        pygame.draw.line(pantalla, ROJO, (cx + 50, cy + 50), manos_der, 20)
        pygame.draw.circle(pantalla, NARANJA, (int(manos_izq[0]), int(manos_izq[1])), 11)
        pygame.draw.circle(pantalla, NARANJA, (int(manos_der[0]), int(manos_der[1])), 11)
    else:
        # brazo izquierdo abajo
        pygame.draw.line(pantalla, ROJO, (cx - 50, cy + 50), (cx - 78, cy + 105), 20)
        pygame.draw.circle(pantalla, NARANJA, (cx - 78, cy + 108), 11)
        # brazo derecho: saluda si está feliz
        if estado == "feliz":
            mano = (cx + 100, cy - 5 + math.sin(t * 8) * 10)
        else:
            mano = (cx + 78, cy + 108)
        pygame.draw.line(pantalla, ROJO, (cx + 50, cy + 50), mano, 20)
        pygame.draw.circle(pantalla, NARANJA, (int(mano[0]), int(mano[1])), 11)

    # orejas
    for lado in (-1, 1):
        pygame.draw.polygon(pantalla, NARANJA, [(cx + lado * 75, cy - 70), (cx + lado * 62, cy - 160), (cx + lado * 15, cy - 100)])
        pygame.draw.polygon(pantalla, CREMA, [(cx + lado * 65, cy - 85), (cx + lado * 60, cy - 138), (cx + lado * 35, cy - 102)])

    # cabeza, cachetes y hocico
    pygame.draw.ellipse(pantalla, NARANJA, (cx - 85, cy - 105, 170, 130))
    pygame.draw.ellipse(pantalla, CREMA, (cx - 82, cy - 50, 76, 62))
    pygame.draw.ellipse(pantalla, CREMA, (cx + 6, cy - 50, 76, 62))
    pygame.draw.ellipse(pantalla, CREMA, (cx - 55, cy - 42, 110, 62))

    # ojos
    for lado in (-1, 1):
        ex = cx + lado * 38
        ey = cy - 62
        if estado == "cansado":
            # ojos cerrados
            pygame.draw.line(pantalla, NEGRO, (ex - 14, ey + 2), (ex + 14, ey + 2), 4)
        else:
            pygame.draw.ellipse(pantalla, BLANCO, (ex - 17, ey - 20, 34, 40))
            mirar_x, mirar_y = 0, 0
            if estado == "programando":
                mirar_x, mirar_y = 8, 3      # mira la pantalla
            elif estado == "triste":
                mirar_y = 7
            px = ex + mirar_x
            py = ey + mirar_y
            pygame.draw.circle(pantalla, AZUL, (px, py), 10)
            pygame.draw.circle(pantalla, NEGRO, (px, py), 5)
            pygame.draw.circle(pantalla, BLANCO, (px - 3, py - 3), 3)
        if estado == "triste":
            # cejas caídas
            pygame.draw.line(pantalla, NEGRO, (ex - lado * 18, ey - 30), (ex + lado * 14, ey - 40), 4)

    # lágrima
    if estado == "triste":
        pygame.draw.ellipse(pantalla, AZUL, (cx - 46, cy - 38, 9, 14))

    # anteojos
    lente = pygame.Surface((60, 60), pygame.SRCALPHA)
    pygame.draw.circle(lente, (120, 190, 255, 60), (30, 30), 27)
    for lado in (-1, 1):
        ex = cx + lado * 38
        ey = cy - 62
        pantalla.blit(lente, (ex - 30, ey - 30))
        pygame.draw.circle(pantalla, NEGRO, (ex, ey), 27, 4)
        pygame.draw.line(pantalla, NEGRO, (ex + lado * 26, ey - 2), (ex + lado * 44, ey - 6), 4)
    pygame.draw.line(pantalla, NEGRO, (cx - 12, ey), (cx + 12, ey), 4)

    # nariz
    pygame.draw.ellipse(pantalla, NEGRO, (cx - 8, cy - 30, 16, 11))

    # boca
    if estado == "feliz":
        pygame.draw.ellipse(pantalla, ROJO, (cx - 11, cy - 15, 22, 15))
        pygame.draw.arc(pantalla, NEGRO, (cx - 22, cy - 28, 44, 30), math.pi * 1.1, math.pi * 1.9, 3)
    elif estado == "programando":
        pygame.draw.arc(pantalla, NEGRO, (cx - 18, cy - 28, 36, 26), math.pi * 1.1, math.pi * 1.9, 3)
    elif estado == "triste":
        pygame.draw.arc(pantalla, NEGRO, (cx - 16, cy - 14, 32, 22), math.pi * 0.15, math.pi * 0.85, 3)
    else:  # cansado: bostezo
        pygame.draw.ellipse(pantalla, ROJO, (cx - 10, cy - 17, 20, 18))
        pygame.draw.ellipse(pantalla, NEGRO, (cx - 10, cy - 17, 20, 18), 2)

    # auriculares
    pygame.draw.arc(pantalla, NEGRO, (cx - 95, cy - 135, 190, 170), 0, math.pi, 9)
    for dx in (-110, 82):
        pygame.draw.rect(pantalla, ROJO, (cx + dx, cy - 78, 28, 56), border_radius=10)
        pygame.draw.rect(pantalla, AMARILLO, (cx + dx, cy - 78, 28, 56), 3, border_radius=10)

    # Zzz cuando está cansado
    if estado == "cansado":
        for i in range(3):
            z = fuente_titulo.render("z", True, BLANCO)
            pantalla.blit(z, (cx - 125 - i * 16, cy - 120 - i * 22 + math.sin(t * 2 + i) * 4))

    if estado == "programando":
        dibujar_pantalla_codigo(t)


def dibujar_todo(tiempo):
    estado = obtener_estado()
    dibujar_fondo()

    # bugs: cuanto menos salud, más bugs
    cantidad_bugs = int((100 - mascota["salud"]) // 20)
    for i in range(min(cantidad_bugs, len(POS_BUGS))):
        dibujar_bug(POS_BUGS[i][0], POS_BUGS[i][1], tiempo)

    dibujar_mascota(estado, tiempo)
    dibujar_encabezado()
    dibujar_barras()
    dibujar_botones()

    if mascota["t_mensaje"] > 0:
        msg = fuente.render(mascota["mensaje"], True, BORDO)
        pantalla.blit(msg, msg.get_rect(center=(ANCHO // 2, 481)))

    pie = fuente_chica.render(
        "Estado: " + estado + "   |   R reiniciar   |   ESC salir", True, BORDO)
    pantalla.blit(pie, pie.get_rect(center=(ANCHO // 2, 580)))


# ---------------------------------------------------------------- game loop
def main():
    tiempo = 0.0
    corriendo = True
    while corriendo:
        dt = reloj.tick(FPS) / 1000
        tiempo += dt

        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                corriendo = False
            elif evento.type == pygame.KEYDOWN:
                if evento.key == pygame.K_ESCAPE:
                    corriendo = False
                elif evento.key == pygame.K_c:
                    tomar_cafe()
                elif evento.key == pygame.K_j:
                    programar()
                elif evento.key == pygame.K_l:
                    limpiar_bugs()
                elif evento.key == pygame.K_r:
                    reiniciar()
            elif evento.type == pygame.MOUSEBUTTONDOWN and evento.button == 1:
                for rect, texto, accion in botones:
                    if rect.collidepoint(evento.pos):
                        accion()

        actualizar(dt)
        dibujar_todo(tiempo)
        pygame.display.flip()

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()
